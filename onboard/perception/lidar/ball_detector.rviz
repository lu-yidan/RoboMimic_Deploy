Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /PointCloud All1
        - /PointCloud Candidates1
        - /Ball Raw1
        - /Ball Kalman Filter1
      Splitter Ratio: 0.5
    Tree Height: 549
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud All
      Topic:
        Value: /ball_detector/cloud_all
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Flat Squares
      Alpha: 1
      Color: 180; 180; 180
      Color Transformer: FlatColor
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud Candidates
      Topic:
        Value: /ball_detector/cloud_candidates
      Queue Size: 10
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.03
      Style: Flat Squares
      Alpha: 1
      Color: 255; 220; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Ball Raw
      Topic:
        Value: /ball_detector/ball_raw
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Ball Kalman Filter
      Topic:
        Value: /ball_detector/ball_kf
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Text Info
      Topic:
        Value: /ball_detector/text_info
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: livox_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1600
  X: 120
  Y: 80
